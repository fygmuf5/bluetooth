<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 畫面一：選擇課程表格 (登入後第一個畫面，僅顯示課表選擇) -->
    <LinearLayout
        android:id="@+id/layout_course_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <!-- 頂部標題與匯入 CSV 按鈕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_schedule_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="學期課表"
                    android:textColor="#212121"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="請點選課程進入點名與管理"
                    android:textColor="#757575"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_import_csv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="匯入 CSV"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 課表列表 (表格卡片) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_course_schedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 畫面二：課程點名與管理功能介面 (點擊特定課程後進入) -->
    <LinearLayout
        android:id="@+id/layout_course_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- 課程頂部導航列：返回按鈕與課程標題 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btn_back_to_schedule"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 返回課表"
                android:textColor="#1976D2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_selected_course_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="人工智慧 (F609)"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 點名總控制卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/teacher_controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_teacher_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="6dp"
                    android:text="點名系統已就緒"
                    android:textColor="#3F51B5"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_attendance_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#4CAF50"
                    android:text="開始點名"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <!-- 出席統計摘要 -->
                <TextView
                    android:id="@+id/tv_attendance_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="出席統計：0 / 0 (0%)"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 功能分頁標籤：即時列表、學生名單、教室熱力圖 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/teacher_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            app:tabGravity="fill"
            app:tabIndicatorColor="#2196F3"
            app:tabMode="fixed"
            app:tabSelectedTextColor="#2196F3">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="即時列表" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="學生名單" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="教室熱力圖" />

        </com.google.android.material.tabs.TabLayout>

        <!-- 分頁內容區 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <!-- Tab 1: 即時掃描列表 -->
            <LinearLayout
                android:id="@+id/layout_realtime_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="即時簽到紀錄："
                    android:textColor="#333333"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/devices_listview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <!-- Tab 2: 學生點名表 (名單 + 搜尋 + 全選) -->
            <LinearLayout
                android:id="@+id/layout_student_grid_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 搜尋與操作列 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <EditText
                        android:id="@+id/et_student_search"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_edittext"
                        android:hint="搜尋學號..."
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_select_all"
                        style="@style/Widget.AppCompat.Button.Borderless.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:text="全選"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_student_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <!-- Tab 3: 教室熱力圖 -->
            <LinearLayout
                android:id="@+id/layout_heatmap_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_heatmap_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="4dp"
                    android:text="教室學生分布熱點圖 (估計)"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_heatmap_student_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:paddingBottom="6dp"
                    android:text="偵測到學生數: 0"
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <com.mcu.bluetooth.HeatmapView
                    android:id="@+id/heatmap_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</FrameLayout>
